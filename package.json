{
  "name": "earshot",
  "version": "1.0.0",
  "description": "Earshot: voice-focused sound amplifier, recorder and transcriber",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
